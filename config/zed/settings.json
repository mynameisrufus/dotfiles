  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "agent": {
    "default_profile": "write",
    "dock": "left",
    "tool_permissions": {
      "default": "allow"
    },
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "zed.dev",
      "model": "claude-sonnet-4-6"
    },
  },
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "preferred_line_length": 80,
  "soft_wrap": "bounded",
  "theme": {
    "mode": "system",
    "light": "Solarized Light",
    "dark": "One Dark"
  },
  "languages": {
    "Ruby": {
      "language_servers": ["solargraph", "rubocop", "!ruby-lsp"],
      "soft_wrap": "none"
    },
    "TypeScript": {
      "soft_wrap": "none"
    },
    "JavaScript": {
      "soft_wrap": "none"
    }
  },
  "lsp": {
    "solargraph": {
      "initialization_options": {
        "diagnostics": true,
        "formatting": true
      }
    }
  }
}
